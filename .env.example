# ─────────────────────────────────────────────────────────────
# TimeSeresGenerator application settings
# Copy to .env and fill in for local development.
# .env is gitignored; this file is committed as a template.
# All variables use the TSGEN_ prefix (see src/tsgen/settings.py).
# ─────────────────────────────────────────────────────────────

# Auth — leave empty to disable persistence (anonymous-only mode).
# When set, POST /v1/runs requires X-API-Key header with this value.
TSGEN_API_KEY=

# Rate limiting (Redis). Leave empty to use in-memory limiter (dev only).
TSGEN_REDIS_URL=

# Database for persistent runs. Leave empty to disable persistence.
TSGEN_DATABASE_URL=

# Storage backend for generated artifacts.
# local | s3 | yandex
TSGEN_STORAGE_BACKEND=local
TSGEN_STORAGE_PATH=./data

# Excel export limits (checked by core/validate.py before generation).
TSGEN_EXCEL_MAX_ROWS=1000000
TSGEN_EXCEL_MAX_COLS=16384

# Logging
TSGEN_LOG_LEVEL=INFO